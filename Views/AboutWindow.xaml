<Window x:Class="FlexCompanion.Views.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="About Flex Companion" Width="760" Height="600"
        WindowStartupLocation="CenterOwner"
        Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Segoe UI" FontSize="12"
        Icon="/FlexCompanion;component/Assets/FlexCompanionIcon.png">
    <Grid Margin="14">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <Border CornerRadius="10" BorderBrush="{StaticResource LineBrush}" BorderThickness="1" Padding="14" Background="#660B0F18">
            <DockPanel LastChildFill="True">
                <Border Width="92" Height="92" CornerRadius="20" BorderBrush="#4000B4D8" BorderThickness="1" Margin="0,0,14,0" Background="#22000000">
                    <Image Source="/FlexCompanion;component/Assets/FlexCompanionIcon.png" Stretch="Uniform" Margin="8"/>
                </Border>
                <StackPanel>
                    <TextBlock Text="Flex Companion" FontSize="24" FontWeight="Bold"/>
                    <TextBlock Text="Open-source FLEX radio companion controller" Foreground="{StaticResource TextDimBrush}" Margin="0,4,0,0"/>
                    <TextBlock Text="Created by Craig Magee M9XDT" Foreground="{StaticResource AccentBrush}" FontWeight="SemiBold" Margin="0,10,0,0"/>
                    <TextBlock Text="Licensed under GNU GPL v3. Includes inspiration and portions derived from AetherSDR under GPLv3, with acknowledgement and attribution preserved." TextWrapping="Wrap" Margin="0,8,0,0"/>
                    <TextBlock Text="Uses the FlexRadio public API/protocol. Not affiliated with or endorsed by FlexRadio Systems / FlexRadio, Inc." TextWrapping="Wrap" Foreground="{StaticResource TextMuteBrush}" Margin="0,8,0,0"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <TabControl Grid.Row="1" Margin="0,12,0,0">
            <TabItem Header="Overview">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="10">
                        <TextBlock Text="This build is intended for open-source sharing and includes in-app licence and attribution information." FontWeight="SemiBold"/>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
Flex Companion provides quick access to FLEX radio DSP controls, meters, AGC-T calibration, DAX IQ FFT, station tools, DX cluster, amplifier control, profiles, memories, macros and raw FLEX API access.
                        </TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,10,0,0">
The companion app can connect to one or two radios simultaneously. The AGC-T helper temporarily disables relevant DSP filters during the scan and restores them afterwards. The application icon and branding shown here are for Flex Companion by Craig Magee M9XDT.
                        </TextBlock>
                        <TextBlock Text="Key credits" Style="{StaticResource Section}" Margin="0,16,0,6"/>
                        <TextBlock TextWrapping="Wrap">• Project creator / maintainer: Craig Magee M9XDT</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">• AetherSDR: inspiration and GPLv3-derived/ported functionality where noted</TextBlock>
                        <TextBlock TextWrapping="Wrap" Margin="0,4,0,0">• FlexRadio public API/protocol: interoperability with compatible radios</TextBlock>
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="GPL v3 licence">
                <Grid>
                    <TextBox x:Name="LicenseTextBox" Margin="8" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#22000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"/>
                </Grid>
            </TabItem>
            <TabItem Header="Acknowledgements">
                <Grid>
                    <TextBox x:Name="NoticeTextBox" Margin="8" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"
                             Background="#22000000" Foreground="{StaticResource TextBrush}" BorderBrush="{StaticResource LineBrush}"/>
                </Grid>
            </TabItem>
        </TabControl>

        <DockPanel Grid.Row="2" Margin="0,12,0,0" LastChildFill="False">
            <TextBlock DockPanel.Dock="Left" Text="Flex Companion © Craig Magee M9XDT" Foreground="{StaticResource TextMuteBrush}" VerticalAlignment="Center"/>
            <Button DockPanel.Dock="Right" Content="Close" Width="110" Padding="12,5" IsDefault="True" Click="OnClose"/>
        </DockPanel>
    </Grid>
</Window>
