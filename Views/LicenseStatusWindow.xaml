<Window x:Class="FlexCompanion.Views.LicenseStatusWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:FlexCompanion.Views"
        Title="Flex Control Companion — Licence &amp; Features"
        Width="940" Height="720" MinWidth="680" MinHeight="450"
        WindowStartupLocation="CenterOwner" Background="{StaticResource Bg0Brush}"
        Foreground="{StaticResource TextBrush}" FontFamily="Segoe UI" FontSize="12"
        Icon="/FlexCompanion;component/Assets/FlexCompanionIcon.png">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>
        <DockPanel>
            <TextBlock Text="LICENCE &amp; FEATURES" FontSize="19" FontWeight="Bold"
                       Foreground="{StaticResource AccentBrush}"/>
            <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                       Text="Read-only radio status" Foreground="{StaticResource TextDimBrush}"/>
        </DockPanel>
        <TabControl Grid.Row="1" Margin="0,14,0,8">
            <TabItem Header="RADIO A">
                <v:LicenseStatusPanel DataContext="{Binding SlotA}"/>
            </TabItem>
            <TabItem Header="RADIO B">
                <v:LicenseStatusPanel DataContext="{Binding SlotB}"/>
            </TabItem>
        </TabControl>
        <DockPanel Grid.Row="2">
            <TextBlock Text="No licence keys, signatures or radio settings are modified."
                       Foreground="{StaticResource TextDimBrush}" VerticalAlignment="Center"/>
            <Button Content="Close" DockPanel.Dock="Right" HorizontalAlignment="Right"
                    Padding="20,6" Click="OnClose"/>
        </DockPanel>
    </Grid>
</Window>
