<UserControl x:Class="FlexCompanion.Views.PttSelectPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <ScrollViewer VerticalScrollBarVisibility="Auto">
        <StackPanel Margin="12">
            <TextBlock Text="{Binding RadioTitle}" FontWeight="Bold" FontSize="17"/>
            <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextDimBrush}" Margin="0,3,0,13"/>
            <TextBlock Text="HARDWARE PTT AUDIO SELECTION" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
            <TextBlock Text="Select what the RCA footswitch, ACC PTT and microphone PTT should transmit."
                       TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,5,0,12"/>
            <TextBlock Text="Requested mode" FontWeight="SemiBold"/>
            <ComboBox ItemsSource="{Binding PttModeOptions}" SelectedItem="{Binding SelectedPttMode,Mode=TwoWay}"
                      DisplayMemberPath="Title" Margin="0,5,0,8" MinWidth="300"/>
            <Button Content="Apply to radio (only when advertised)" Command="{Binding ApplyPttSelectionCommand}"
                    Margin="0,0,0,12" HorizontalAlignment="Left" Padding="14,5"/>
            <TextBlock Text="{Binding PttActionStatus}" TextWrapping="Wrap"
                       Foreground="{StaticResource AmberBrush}" Margin="0,0,0,12"/>
            <Border BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                    CornerRadius="5" Background="{StaticResource CardBrush}" Padding="12">
                <StackPanel>
                    <TextBlock Text="RADIO-REPORTED STATUS" Foreground="{StaticResource AccentBrush}" FontWeight="Bold"/>
                    <TextBlock Text="{Binding PttReportedMode}" TextWrapping="Wrap" Margin="0,7,0,6"/>
                    <TextBlock Text="{Binding PttMicSelection,StringFormat='Selected microphone: {0}'}"/>
                    <TextBlock Text="{Binding PttSource,StringFormat='Last PTT source: {0}'}" Margin="0,4,0,0"/>
                    <TextBlock Text="{Binding PttInterlock,StringFormat='Interlock state: {0}'}" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
            <TextBlock Text="SmartSDR 4.3 defaults to keeping the selected PC/DAX audio with hardware PTT. The override checkbox in SmartSDR is at Settings > Radio Setup > Phone/CW. Third-party write syntax has not yet been confirmed on a live v4.3.16 radio: this experimental Apply button remains disabled unless the radio advertises ptt_override=0/1. It never keys TX or changes an audio input or safety interlock."
                       TextWrapping="Wrap" Foreground="{StaticResource TextDimBrush}" Margin="0,12,0,0"/>
        </StackPanel>
    </ScrollViewer>
</UserControl>
