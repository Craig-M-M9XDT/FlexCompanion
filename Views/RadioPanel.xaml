<UserControl x:Class="FlexCompanion.Views.RadioPanel"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:c="clr-namespace:FlexCompanion.Controls"
             xmlns:vm="clr-namespace:FlexCompanion.ViewModels">
    <UserControl.Resources>
        <Style x:Key="MultiMeterTile" TargetType="Border">
            <Setter Property="Background" Value="#70101A26"/>
            <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="3"/>
            <Setter Property="Margin" Value="3"/>
            <Setter Property="Padding" Value="7,5"/>
        </Style>
    </UserControl.Resources>
    <Grid>
        <Border Style="{StaticResource Card}" Padding="0">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <Border Background="#991A2A3A" BorderBrush="{StaticResource LineBrush}" BorderThickness="0,0,0,1" Padding="12,8" CornerRadius="4,4,0,0">
                    <DockPanel>
                        <Border DockPanel.Dock="Left" Background="{StaticResource AccentBrush}" CornerRadius="3" Width="26" Height="26" Margin="0,0,10,0">
                            <TextBlock Text="{Binding Slot}" Foreground="Black" FontWeight="Bold" FontSize="14"
                                       HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                            <Border x:Name="TxLamp" CornerRadius="3" Padding="8,2" Margin="0,0,8,0" BorderThickness="1">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Setter Property="Background" Value="Transparent"/>
                                        <Setter Property="BorderBrush" Value="{StaticResource LineBrush}"/>
                                        <Setter Property="TextElement.Foreground" Value="{StaticResource TextMuteBrush}"/>
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsTransmitting}" Value="True">
                                                <Setter Property="Background" Value="{StaticResource RedBrush}"/>
                                                <Setter Property="BorderBrush" Value="{StaticResource RedBrush}"/>
                                                <Setter Property="TextElement.Foreground" Value="White"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <TextBlock Text="TX" FontWeight="Bold" x:Name="TxText"/>
                            </Border>
                            <Button Content="Reconnect" Command="{Binding ReconnectCommand}" Padding="8,3" Margin="0,0,4,0"/>
                            <Button Content="Disconnect" Command="{Binding DisconnectCommand}" Padding="8,3"/>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="{Binding RadioTitle}" FontWeight="SemiBold" FontSize="14" TextTrimming="CharacterEllipsis"/>
                            <TextBlock Text="{Binding StatusText}" Style="{StaticResource Hint}" TextTrimming="CharacterEllipsis"/>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- Slice / station selection -->
                <Grid Grid.Row="1" Margin="12,10,12,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <StackPanel>
                        <TextBlock Text="SLICE" Style="{StaticResource Section}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Slices}" SelectedItem="{Binding SelectedSlice}"
                                  ItemTemplate="{StaticResource SliceItemTemplate}"/>
                    </StackPanel>
                    <StackPanel Grid.Column="1" Margin="8,0,0,0">
                        <TextBlock Text="STATION (GUI CLIENT)" Style="{StaticResource Section}" Margin="0,0,0,3"/>
                        <ComboBox ItemsSource="{Binding Stations}" SelectedItem="{Binding SelectedStation}" DisplayMemberPath="Name"
                                  ToolTip="Which SmartSDR/AetherSDR station the slice list and station-scoped controls act for"/>
                    </StackPanel>
                    <ToggleButton Grid.Column="2" Content="Follow" IsChecked="{Binding FollowActiveSlice}" Padding="10,5"
                                  Margin="8,0,0,0" VerticalAlignment="Bottom"
                                  ToolTip="Automatically follow the active slice of the selected station"/>
                </Grid>

                <!-- Meters -->
                <Border Grid.Row="2" Background="{StaticResource InsetBrush}" BorderBrush="{StaticResource LineBrush}" BorderThickness="1"
                        CornerRadius="3" Margin="12,10,12,0" Padding="10,8">
                    <StackPanel>
                        <!-- meter options -->
                        <DockPanel Margin="0,0,0,6">
                            <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                <StackPanel Orientation="Horizontal" Visibility="{Binding ShowSingleTxSelector, Converter={StaticResource BoolVis}}">
                                    <TextBlock Text="TX" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <ComboBox ItemsSource="{x:Static vm:RadioViewModel.TxMeterOptions}" SelectedItem="{Binding TxMeter}"
                                              Width="92" ToolTip="What the single meter shows while transmitting"/>
                                </StackPanel>
                                <ToggleButton Content="FFT" IsChecked="{Binding ShowFft}" Padding="10,3" Margin="6,0,0,0"
                                              ToolTip="Show the compact spectrum. Uses Aether shared pan data when available, otherwise falls back to direct FLEX DAX IQ."/>
                            </StackPanel>
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="METER" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                <ComboBox ItemsSource="{x:Static vm:RadioViewModel.MeterModeOptions}" SelectedItem="{Binding MeterMode}"
                                          Width="156" ToolTip="Choose the meter layout"/>
                            </StackPanel>
                        </DockPanel>

                        <!-- analogue: one dial that swaps RX / TX automatically -->
                        <Grid Visibility="{Binding IsSimpleAnalogue, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="96"/>
                            </Grid.ColumnDefinitions>
                            <c:AnalogMeter Height="128" MaxWidth="440" HorizontalAlignment="Stretch"
                                           Minimum="{Binding DialMin}" Maximum="{Binding DialMax}" RedFrom="{Binding DialRed}"
                                           ScaleLabels="{Binding DialScale}" Title="{Binding DialTitle}"
                                           IsTransmit="{Binding IsTransmitting}" Value="{Binding DialValue}"/>
                            <StackPanel Grid.Column="1" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding DialText}" Style="{StaticResource ReadoutBig}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding DialSub}" Style="{StaticResource ReadoutSmall}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding VddText}" Style="{StaticResource Hint}" HorizontalAlignment="Right" Margin="0,8,0,0" ToolTip="Supply voltage"/>
                                <TextBlock Text="{Binding TempText}" Style="{StaticResource Hint}" HorizontalAlignment="Right" ToolTip="PA temperature"/>
                            </StackPanel>
                        </Grid>

                        <!-- digital bars -->
                        <Grid Visibility="{Binding IsDigitalSelect, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="44"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="84"/>
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                                <RowDefinition Height="Auto"/>
                            </Grid.RowDefinitions>

                            <TextBlock Text="RX" Style="{StaticResource MeterTag}" VerticalAlignment="Center"/>
                            <c:LevelMeter Grid.Column="1" Height="30" Margin="4,2"
                                          Minimum="-127" Maximum="-13" WarnValue="-73" DangerValue="-33"
                                          BaseColor="#00B4D8" ScaleLabels="-121:1,-109:3,-97:5,-85:7,-73:9,-53:+20,-33:+40,-13:+60"
                                          Value="{Binding RxDbm}"/>
                            <StackPanel Grid.Column="2" VerticalAlignment="Center" HorizontalAlignment="Right">
                                <TextBlock Text="{Binding RxSText}" Style="{StaticResource ReadoutBig}" HorizontalAlignment="Right"/>
                                <TextBlock Text="{Binding RxDbmText}" Style="{StaticResource ReadoutSmall}" HorizontalAlignment="Right"/>
                            </StackPanel>

                            <TextBlock Grid.Row="1" Text="PWR" Style="{StaticResource MeterTag}" VerticalAlignment="Center"/>
                            <c:LevelMeter Grid.Row="1" Grid.Column="1" Height="14" Margin="4,3"
                                          Minimum="0" Maximum="{Binding PowerMax}" WarnValue="100000" DangerValue="100000"
                                          BaseColor="#FF4D4D" Value="{Binding FwdWatts}"/>
                            <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding PowerText}" Style="{StaticResource ReadoutSmall}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <TextBlock Grid.Row="2" Text="SWR" Style="{StaticResource MeterTag}" VerticalAlignment="Center"/>
                            <c:LevelMeter Grid.Row="2" Grid.Column="1" Height="14" Margin="4,3"
                                          Minimum="1" Maximum="3" WarnValue="1.5" DangerValue="2.5"
                                          BaseColor="#4DD87A" ScaleLabels="1.5:1.5,2:2,2.5:2.5" Value="{Binding Swr}"/>
                            <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding SwrText}" Style="{StaticResource ReadoutSmall}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"/>

                            <!-- the chosen TX meter, when it isn't PWR or SWR -->
                            <TextBlock Grid.Row="3" Text="{Binding TxSpec.Key}" Style="{StaticResource MeterTag}" VerticalAlignment="Center"
                                       Visibility="{Binding TxSelIsExtra, Converter={StaticResource BoolVis}}"/>
                            <c:LevelMeter Grid.Row="3" Grid.Column="1" Height="14" Margin="4,3"
                                          Minimum="{Binding TxSpec.Min}" Maximum="{Binding TxSpec.Max}"
                                          WarnValue="{Binding TxSpec.Red}" DangerValue="{Binding TxSpec.Red}"
                                          BaseColor="#FFB84D" Value="{Binding TxSelValue}"
                                          Visibility="{Binding TxSelIsExtra, Converter={StaticResource BoolVis}}"/>
                            <TextBlock Grid.Row="3" Grid.Column="2" Text="{Binding TxSelText}" Style="{StaticResource ReadoutSmall}"
                                       HorizontalAlignment="Right" VerticalAlignment="Center"
                                       Visibility="{Binding TxSelIsExtra, Converter={StaticResource BoolVis}}"/>
                        </Grid>

                        <!-- compound analogue: three independently scaled selectable needles -->
                        <Grid Visibility="{Binding IsMultiAnalogue, Converter={StaticResource BoolVis}}">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="142"/>
                            </Grid.ColumnDefinitions>
                            <c:MultiAnalogMeter Height="134" MaxWidth="460" HorizontalAlignment="Stretch"
                                                Value1="{Binding MultiValue1}" Minimum1="{Binding MultiSpec1.Min}" Maximum1="{Binding MultiSpec1.Max}" RedFrom1="{Binding MultiSpec1.Red}" Label1="{Binding MultiSpec1.Key}"
                                                Value2="{Binding MultiValue2}" Minimum2="{Binding MultiSpec2.Min}" Maximum2="{Binding MultiSpec2.Max}" RedFrom2="{Binding MultiSpec2.Red}" Label2="{Binding MultiSpec2.Key}"
                                                Value3="{Binding MultiValue3}" Minimum3="{Binding MultiSpec3.Min}" Maximum3="{Binding MultiSpec3.Max}" RedFrom3="{Binding MultiSpec3.Red}" Label3="{Binding MultiSpec3.Key}"/>
                            <Grid Grid.Column="1" Margin="8,0,0,0" VerticalAlignment="Center">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="14"/>
                                    <ColumnDefinition Width="82"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>
                                <Ellipse Width="8" Height="8" Fill="#FFB84D"/>
                                <ComboBox Grid.Column="1" Margin="2" ItemsSource="{x:Static vm:RadioViewModel.TxMeterOptions}" SelectedItem="{Binding MultiNeedle1}"/>
                                <TextBlock Grid.Column="2" Text="{Binding MultiText1}" Style="{StaticResource ReadoutSmall}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Ellipse Grid.Row="1" Width="8" Height="8" Fill="#4DD87A"/>
                                <ComboBox Grid.Row="1" Grid.Column="1" Margin="2" ItemsSource="{x:Static vm:RadioViewModel.TxMeterOptions}" SelectedItem="{Binding MultiNeedle2}"/>
                                <TextBlock Grid.Row="1" Grid.Column="2" Text="{Binding MultiText2}" Style="{StaticResource ReadoutSmall}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                                <Ellipse Grid.Row="2" Width="8" Height="8" Fill="#00B4D8"/>
                                <ComboBox Grid.Row="2" Grid.Column="1" Margin="2" ItemsSource="{x:Static vm:RadioViewModel.TxMeterOptions}" SelectedItem="{Binding MultiNeedle3}"/>
                                <TextBlock Grid.Row="2" Grid.Column="2" Text="{Binding MultiText3}" Style="{StaticResource ReadoutSmall}" VerticalAlignment="Center" HorizontalAlignment="Right"/>
                            </Grid>
                        </Grid>

                        <!-- digital multimeter: RX plus every available TX parameter -->
                        <UniformGrid Columns="4" Rows="2" Visibility="{Binding IsDigitalMultimeter, Converter={StaticResource BoolVis}}">
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="RX" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding RxSText}" Style="{StaticResource ReadoutBig}"/><TextBlock Text="{Binding RxDbmText}" Style="{StaticResource Hint}"/></StackPanel></Border>
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="POWER" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding PowerText}" Style="{StaticResource ReadoutBig}"/></StackPanel></Border>
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="SWR" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding SwrText}" Style="{StaticResource ReadoutBig}"/></StackPanel></Border>
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="PROC" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding CompText}" Style="{StaticResource ReadoutBig}"/></StackPanel></Border>
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="MIC" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding MicText}" Style="{StaticResource ReadoutBig}"/></StackPanel></Border>
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="VDD" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding VddText}" Style="{StaticResource ReadoutBig}"/></StackPanel></Border>
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="CURRENT" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding AmpsText}" Style="{StaticResource ReadoutBig}"/></StackPanel></Border>
                            <Border Style="{StaticResource MultiMeterTile}"><StackPanel><TextBlock Text="PA TEMP" Style="{StaticResource MeterTag}"/><TextBlock Text="{Binding TempText}" Style="{StaticResource ReadoutBig}"/></StackPanel></Border>
                        </UniformGrid>

                        <!-- optional FFT -->
                        <StackPanel Margin="0,8,0,0" Visibility="{Binding ShowFft, Converter={StaticResource BoolVis}}">
                            <c:SpectrumView Height="96" Spectrum="{Binding Spectrum}" MaxHz="{Binding SpectrumMaxHz}" SampleRate="{Binding SpectrumSampleRate}" Centered="{Binding SpectrumCentered}"
                                            CenterOffsetHz="{Binding SpectrumCenterOffsetHz}" MarkerFraction="{Binding SpectrumSliceFraction}" ShowWaterfall="False"/>
                            <DockPanel Margin="0,4,0,0">
                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                                    <TextBlock Text="Width" Style="{StaticResource Hint}" VerticalAlignment="Center" Margin="8,0,6,0"/>
                                    <ComboBox Width="84" ItemsSource="{x:Static vm:RadioViewModel.FftSpanOptionsKhz}" SelectedItem="{Binding FftSpanKhz}"
                                              ItemStringFormat="{}{0:0} kHz" ToolTip="Total width of the FFT window, centred on the selected slice"/>
                                </StackPanel>
                                <TextBlock Text="{Binding SpectrumStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"
                                           ToolTip="AUTO source: reuses Aether's existing radio FFT when the localhost bridge is present; otherwise Companion falls back to its own DAX IQ stream."/>
                            </DockPanel>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Controls -->
                <TabControl Grid.Row="3" Margin="12,10,12,0">
                    <TabItem Header="Noise &amp; notch">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="NOISE REDUCTION" Style="{StaticResource Section}"/>
                                <ItemsControl ItemsSource="{Binding NoiseReduction}" ItemTemplate="{StaticResource ParamRow}" Margin="0,4,0,10"/>
                                <TextBlock Text="NOISE BLANKER" Style="{StaticResource Section}"/>
                                <ItemsControl ItemsSource="{Binding Blanker}" ItemTemplate="{StaticResource ParamRow}" Margin="0,4,0,10"/>
                                <TextBlock Text="NOTCH" Style="{StaticResource Section}"/>
                                <ItemsControl ItemsSource="{Binding Notch}" ItemTemplate="{StaticResource ParamRow}" Margin="0,4,0,10"/>
                                <TextBlock Text="PANADAPTER" Style="{StaticResource Section}"/>
                                <ItemsControl ItemsSource="{Binding Display}" ItemTemplate="{StaticResource ParamRow}" Margin="0,4,0,6"/>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap"
                                           Text="Dimmed rows are unavailable in the current mode/state, not reported by this radio, or unsupported. The status line below shows the reason and FLEX error code. NRF / NRS / RNN are model/firmware dependent."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="ESC &amp; CW">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="ENHANCED SIGNAL CLARITY" Style="{StaticResource Section}"/>
                                <ItemsControl ItemsSource="{Binding Esc}" ItemTemplate="{StaticResource ParamRow}" Margin="0,4,0,4"/>
                                <TextBlock Text="{Binding EscNote}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,14"/>

                                <TextBlock Text="CW AUTO TUNE" Style="{StaticResource Section}"/>
                                <TextBlock Text="{Binding SliceModeText}" Style="{StaticResource Hint}" Margin="0,4,0,6"/>
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Auto tune once" Command="{Binding AutoTuneOnceCommand}" Padding="14,5"
                                            ToolTip="Zero-beat the selected slice on the strongest nearby CW signal"/>
                                    <ToggleButton Content="Intermittent" IsChecked="{Binding AutoTuneIntermittent}" Padding="14,5" Margin="8,0,0,0"
                                                  ToolTip="Keep re-centring the CW signal periodically"/>
                                </StackPanel>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Auto tune only works in CW mode and needs SmartSDR 3.x firmware or later."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>

                    <TabItem Header="AGC-T">
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <StackPanel Margin="4,6,4,4">
                                <TextBlock Text="AGC THRESHOLD" Style="{StaticResource Section}"/>
                                <TextBlock Text="{Binding AgcModeText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,4,0,8"/>
                                <Grid Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="48"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="AGC-T" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Slider Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                                            Minimum="0" Maximum="100" SmallChange="1" LargeChange="10"
                                            IsSnapToTickEnabled="True" TickFrequency="1"
                                            Value="{Binding AgcValue}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AgcValueText}" Style="{StaticResource ReadoutSmall}" HorizontalAlignment="Right"/>
                                </Grid>

                                <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                                    <Button Content="Find best AGC-T" Command="{Binding AgcAutoCommand}" Padding="14,5"
                                            ToolTip="Sweeps AGC-T from 100 to 0 while measuring the slice's audio noise, then picks the knee"/>
                                    <Button Content="Keep" Command="{Binding AgcKeepCommand}" Padding="14,5" Margin="8,0,0,0"/>
                                    <Button Content="Restore" Command="{Binding AgcRestoreCommand}" Padding="14,5" Margin="8,0,0,0"
                                            ToolTip="Stop / put back the value you had before the sweep"/>
                                </StackPanel>

                                <TextBlock Text="{Binding AgcResultText}" Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,0,0,6"/>
                                <c:AgcCurveView Height="130" Points="{Binding AgcCurve}" Current="{Binding AgcValue}" Recommended="{Binding AgcRecommended}"/>

                                <Grid Margin="0,10,0,0" Visibility="{Binding AgcIsOff, Converter={StaticResource BoolVis}}">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="72"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="56"/>
                                    </Grid.ColumnDefinitions>
                                    <TextBlock Text="TARGET" FontWeight="SemiBold" Foreground="{StaticResource TextDimBrush}"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"
                                               ToolTip="Comfortable audio noise level to aim for when AGC is off"/>
                                    <Slider Grid.Column="1" Margin="12,0,8,0" VerticalAlignment="Center"
                                            Minimum="-50" Maximum="-10" SmallChange="1" LargeChange="5"
                                            Value="{Binding AgcTargetDb}"/>
                                    <TextBlock Grid.Column="2" Text="{Binding AgcTargetDb, StringFormat={}{0:0} dB}" Style="{StaticResource ReadoutSmall}" HorizontalAlignment="Right"/>
                                </Grid>

                                <TextBlock Text="{Binding AgcWarning}" Foreground="{StaticResource AmberBrush}" TextWrapping="Wrap" Margin="0,8,0,0"/>
                                <DockPanel Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="Assign DAX channel" Command="{Binding AssignDaxCommand}" Padding="8,2"
                                            Visibility="{Binding NeedsDax, Converter={StaticResource BoolVis}}"/>
                                    <TextBlock Text="{Binding AudioStatus}" Style="{StaticResource Hint}" TextWrapping="Wrap" VerticalAlignment="Center"/>
                                </DockPanel>
                                <TextBlock Style="{StaticResource Hint}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Text="Measures the slice's own audio through a DAX channel (after AGC, before volume), so your speaker volume doesn't matter. Tune to a quiet spot first."/>
                            </StackPanel>
                        </ScrollViewer>
                    </TabItem>


                </TabControl>

                <!-- Last radio message -->
                <TextBlock Grid.Row="4" Text="{Binding LastMessage}" Foreground="{StaticResource AmberBrush}" FontSize="11"
                           Margin="12,6,12,10" TextWrapping="Wrap" MaxHeight="48" TextTrimming="CharacterEllipsis"/>
            </Grid>
        </Border>

    </Grid>
</UserControl>
