<Window x:Class="FlexCompanion.Views.SplashWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="520" Height="330"
        WindowStyle="None" ResizeMode="NoResize"
        WindowStartupLocation="CenterScreen"
        ShowInTaskbar="False" Topmost="True"
        AllowsTransparency="True" Background="Transparent">
    <Border CornerRadius="22" BorderBrush="#FF00B4D8" BorderThickness="1.5" Background="#FA0B0F18">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="0" Opacity="0.65" Color="#FF008ED8"/>
        </Border.Effect>
        <Grid Margin="26">
            <Grid.RowDefinitions>
                <RowDefinition Height="*"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <Grid Grid.Row="0" Width="164" Height="164" HorizontalAlignment="Center">
                <Image x:Name="SplashImage"
                       Width="164" Height="164" Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       SnapsToDevicePixels="True"/>
                <Border x:Name="SplashImageFallback"
                        Visibility="Collapsed"
                        CornerRadius="28"
                        BorderBrush="#FF00B4D8" BorderThickness="2"
                        Background="#FF071421">
                    <TextBlock Text="FCC" FontSize="46" FontWeight="Bold"
                               Foreground="#FF00D4FF"
                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
            </Grid>

            <TextBlock Grid.Row="1" Text="FLEX CONTROL COMPANION"
                       FontSize="26" FontWeight="Bold" Foreground="White"
                       HorizontalAlignment="Center" Margin="0,10,0,0"/>
            <TextBlock Grid.Row="2" Text="Created by Craig Magee M9XDT"
                       FontSize="13" FontWeight="SemiBold" Foreground="#FF00D4FF"
                       HorizontalAlignment="Center" Margin="0,5,0,0"/>
            <StackPanel Grid.Row="3" Margin="0,12,0,0">
                <ProgressBar Height="3" IsIndeterminate="True" BorderThickness="0"/>
                <TextBlock Text="GPLv3 open-source FLEX radio companion · AetherSDR acknowledged"
                           Foreground="#FF8294A8" FontSize="10.5" HorizontalAlignment="Center" Margin="0,8,0,0"/>
            </StackPanel>
        </Grid>
    </Border>
</Window>
